{
  "description": "SpecTracer lifecycle guardrails and validation gates.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/project_context.py\"",
            "commandWindows": "powershell -NoProfile -Command \"py -3 (Join-Path $env:PLUGIN_ROOT 'hooks/project_context.py')\"",
            "timeout": 10,
            "statusMessage": "Loading SpecTracer plugin rules",
            "additionalContextLimit": 800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^apply_patch$|^Edit$|^Write$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/protect_canonical_data.py\"",
            "commandWindows": "powershell -NoProfile -Command \"py -3 (Join-Path $env:PLUGIN_ROOT 'hooks/protect_canonical_data.py')\"",
            "timeout": 10,
            "statusMessage": "Protecting canonical verification data"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/validate_on_stop.py\"",
            "commandWindows": "powershell -NoProfile -Command \"py -3 (Join-Path $env:PLUGIN_ROOT 'hooks/validate_on_stop.py')\"",
            "timeout": 600,
            "statusMessage": "Running SpecTracer validation gates"
          }
        ]
      }
    ]
  }
}
